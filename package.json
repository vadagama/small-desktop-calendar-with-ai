{
  "name": "small-desktop-calendar",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --import tsx --test tests/agent/*.test.ts",
    "test:wails": "MACOSX_DEPLOYMENT_TARGET=15.1 SMALL_WAILS_WEBVIEW_TEST=1 go -C desktop-wails test -count=1 ./...",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "build": "npm run build:wails:assets",
    "format:check": "prettier --check package.json tsconfig*.json 'desktop-wails/*.ts' src tests 'scripts/*.mjs'",
    "build:wails:assets": "vite build --config desktop-wails/assistant.vite.config.ts && vite build --config desktop-wails/vite.config.ts",
    "package:wails:mac": "npm run build:wails:assets && node scripts/package-wails-mac.mjs",
    "voice:build": "node scripts/build-whisper.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.80",
    "ai": "7.0.155",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.159",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dockview-react": "8.7.1",
    "lucide-react": "1.63.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "npm@10.9.8"
}
