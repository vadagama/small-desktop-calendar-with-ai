{
  "name": "small-desktop-calendar",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --import tsx --test tests/agent/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "build": "tsc -p tsconfig.json",
    "format:check": "prettier --check package.json tsconfig*.json *.config.ts src tests scripts/*.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build:desktop": "electron-vite build",
    "package:mac": "npm run build:desktop && node scripts/package-mac.mjs",
    "test:desktop": "playwright test -c playwright.desktop.config.ts",
    "pretest:desktop": "install-electron",
    "package:mac:local": "npm run build:desktop && node scripts/package-mac.mjs --local-sign",
    "package:dmg:local": "npm run package:mac:local && node scripts/package-dmg.mjs",
    "check:size": "node scripts/check-build-size.mjs",
    "check:package": "node scripts/check-package.mjs",
    "package:mac:hardened": "npm run build:desktop && node scripts/package-mac.mjs --local-sign --hardened --out release/hardened",
    "package:mac:release": "npm run build:desktop && node scripts/package-mac.mjs --release-sign --out release/production",
    "voice:build": "node scripts/build-whisper.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.80",
    "ai": "7.0.155",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.159",
    "@electron/asar": "4.3.1",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dockview-react": "8.7.1",
    "electron": "45.1.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.63.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "main": "out/main/index.js",
  "packageManager": "npm@10.9.8"
}
